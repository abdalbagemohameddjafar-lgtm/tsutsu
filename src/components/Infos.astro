---
// Infos pratiques — le SEUL endroit du contenu avec horaires, statut, adresse, téléphone et plan.
// Coordonnées du plan : COORDONNEES_PLAN dans src/config/restaurant.ts.
import { restaurant, horairesTexte, COORDONNEES_PLAN } from '../config/restaurant';

const { adresse } = restaurant;
const { lat, lon } = COORDONNEES_PLAN;
const d = 0.006;
const osm = `https://www.openstreetmap.org/export/embed.html?bbox=${lon - d}%2C${lat - d / 2}%2C${lon + d}%2C${lat + d / 2}&layer=mapnik&marker=${lat}%2C${lon}`;
const osmLien = `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lon}#map=17/${lat}/${lon}`;
---

<section class="section infos" id="infos" aria-labelledby="infos-titre">
  <div class="conteneur infos__grille" data-centre data-aimant>
    <div class="infos__texte">
      <div class="infos__tete">
        <p class="kotoba" data-apparition><span class="kotoba__ja" lang="ja">ご案内</span><span class="kotoba__fr">go-annai · les infos</span></p>
        <h2 id="infos-titre" data-apparition>Infos</h2>
      </div>

      <dl class="infos__liste">
        <div>
          <dt>Horaires</dt>
          <dd>
            {horairesTexte.map((h) => <p>{h.jours} · <span class="mono">{h.heures}</span></p>)}
            <p class="infos__statut" data-statut><span class="infos__point" aria-hidden="true"></span><span data-statut-texte></span></p>
          </dd>
        </div>
        <div>
          <dt>Adresse</dt>
          <dd><address>{adresse.rue}<br />{adresse.codePostal} {adresse.ville}</address></dd>
        </div>
        <div>
          <dt>Téléphone</dt>
          <dd><a class="lien mono" href={`tel:${restaurant.telephone.lien}`}>{restaurant.telephone.affichage}</a></dd>
        </div>
      </dl>
      <button class="bouton" type="button" data-ouvrir-panier aria-haspopup="dialog">Commander en click & collect <span class="fleche" aria-hidden="true">→</span></button>
    </div>

    <div class="infos__plan">
      <!-- Le bandeau de crédits intégré au plan (2 lignes sur mobile) est masqué par le cadre ;
           le crédit OpenStreetMap obligatoire est affiché juste en dessous, en plus compact. -->
      <div class="infos__cadre">
        <iframe title="Plan d’accès à TSUTSU (OpenStreetMap)" src={osm} loading="lazy" referrerpolicy="no-referrer"></iframe>
        <p class="infos__credit">© <a href="https://www.openstreetmap.org/copyright" rel="noopener">Contributeurs OpenStreetMap</a></p>
      </div>
      <a class="lien" href={osmLien} rel="noopener">Agrandir le plan</a>
    </div>
  </div>
</section>

<style>
  .infos__grille {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .infos__texte {
    display: grid;
    gap: 32px;
    justify-items: start;
  }
  .infos__liste {
    display: grid;
    width: 100%;
    border-top: 1px solid var(--ligne);
  }
  .infos__liste > div {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: 8px 24px;
    padding-block: 18px;
    border-bottom: 1px solid var(--ligne);
  }
  .infos__liste dt {
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lanterne);
    padding-top: 4px;
  }
  .infos__liste dd {
    display: grid;
    gap: 4px;
  }
  .infos__liste address {
    font-style: normal;
  }
  .infos__liste .lien {
    min-height: 44px;
    margin-block: -10px;
    font-size: 1.1rem;
  }
  .infos__statut {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--texte-2);
    font-size: 15px;
  }
  .infos__point {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--texte-2);
  }
  .infos__statut[data-ouvert='true'] {
    color: var(--lanterne);
  }
  .infos__statut[data-ouvert='true'] .infos__point {
    background: var(--lanterne);
    box-shadow: 0 0 0 4px rgba(240, 162, 59, 0.2);
  }
  .infos__plan {
    display: grid;
    gap: 6px;
    justify-items: start;
  }
  .infos__cadre {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--ligne-forte);
    border-radius: var(--rayon);
    background: var(--surface);
  }
  .infos__cadre iframe {
    display: block;
    width: 100%;
    height: calc(100% + 46px); /* le bas du plan (bandeau de crédits d'origine) dépasse et est masqué */
    border: 0;
    filter: grayscale(0.35) brightness(0.92);
  }
  .infos__credit {
    position: absolute;
    right: 0;
    bottom: 0;
    max-width: 100%;
    padding: 2px 8px;
    border-top-left-radius: 6px;
    background: rgba(18, 22, 31, 0.72);
    color: var(--papier);
    font-size: 12px;
    line-height: 1.5;
    white-space: nowrap;
  }
  .infos__credit a {
    color: inherit;
    text-underline-offset: 2px;
  }
  .infos__credit a {
    position: relative;
  }
  .infos__credit a::after {
    /* zone de clic agrandie (44 px de haut) sans grossir le bandeau */
    content: '';
    position: absolute;
    inset: -20px -4px -8px;
  }
  @media (max-width: 899px) {
    .infos__grille {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 479px) {
    .infos__liste > div {
      grid-template-columns: 1fr;
    }
  }
</style>
