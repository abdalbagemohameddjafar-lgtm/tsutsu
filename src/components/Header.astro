---
// En-tête fixe : logo, liens, petit statut ouvert/fermé en temps réel, bouton « Commander » (ouvre le panier).
import Logo from './Logo.astro';
interface Props {
  accueil?: boolean;
}
const { accueil = false } = Astro.props;
const base = accueil ? '' : '/';
const liens = [
  { href: `${base}#carte`, texte: 'La carte' },
  { href: `${base}#comptoir`, texte: 'Le comptoir' },
  { href: `${base}#reserver`, texte: 'Réserver' },
  { href: `${base}#infos`, texte: 'Infos' },
];
---

<header class="entete">
  <div class="conteneur entete__barre">
    <a class="entete__logo" href={accueil ? '#top' : '/'}><Logo /><span class="cache"> — accueil</span></a>

    <nav class="entete__nav" id="menu-principal" aria-label="Menu principal">
      {liens.map((l) => <a href={l.href}>{l.texte}</a>)}
    </nav>

    <p class="statut" data-statut role="status" aria-live="polite">
      <span class="statut__point" aria-hidden="true"></span><span data-statut-texte>11h – 22h</span>
    </p>

    <button class="bouton bouton--petit entete__commander" type="button" data-ouvrir-panier aria-haspopup="dialog">
      Commander
      <span class="entete__compte" data-compte-panier hidden>0</span>
      <span class="cache" data-compte-panier-texte></span>
    </button>

    <button class="entete__burger" type="button" aria-expanded="false" aria-controls="menu-principal" aria-label="Ouvrir le menu">
      <span></span><span></span>
    </button>
  </div>
</header>

<script>
  import { statut } from '../lib/horaires';

  // ---------- Statut ouvert / fermé (recalculé chaque minute) ----------
  const blocs = document.querySelectorAll<HTMLElement>('[data-statut]');
  function majStatut() {
    const s = statut();
    blocs.forEach((b) => {
      b.dataset.ouvert = String(s.ouvert);
      const t = b.querySelector('[data-statut-texte]');
      if (t) t.textContent = s.texte;
    });
  }
  majStatut();
  setInterval(majStatut, 60_000);

  // ---------- Menu mobile ----------
  const burger = document.querySelector<HTMLButtonElement>('.entete__burger')!;
  const racine = document.documentElement;
  function basculer(ouvrir: boolean) {
    burger.setAttribute('aria-expanded', String(ouvrir));
    burger.setAttribute('aria-label', ouvrir ? 'Fermer le menu' : 'Ouvrir le menu');
    racine.classList.toggle('menu-ouvert', ouvrir);
  }
  burger.addEventListener('click', () => basculer(burger.getAttribute('aria-expanded') !== 'true'));
  document.querySelectorAll('.entete__nav a').forEach((a) => a.addEventListener('click', () => basculer(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && racine.classList.contains('menu-ouvert')) {
      basculer(false);
      burger.focus();
    }
  });
  matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && basculer(false));
</script>

<style>
  .entete {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    height: var(--header);
    background: rgba(18, 22, 31, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--ligne);
  }
  .entete__barre {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .entete__logo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 21px;
    text-decoration: none;
    margin-right: auto;
  }
  .entete__nav {
    display: flex;
    gap: 6px;
  }
  .entete__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    font-weight: 500;
    font-size: 15px;
    text-decoration: none;
    color: var(--texte-2);
    transition: color 200ms ease;
  }
  .entete__nav a:hover {
    color: var(--papier);
  }

  /* Statut ouvert / fermé : petit point qui s'allume */
  .statut {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--texte-2);
    white-space: nowrap;
  }
  .statut__point {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--texte-2);
  }
  .statut[data-ouvert='true'] .statut__point {
    background: var(--lanterne);
    box-shadow: 0 0 0 4px rgba(240, 162, 59, 0.2);
  }

  .entete__commander {
    position: relative;
  }
  .entete__compte {
    display: inline-grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: 999px;
    background: var(--encre);
    color: var(--lanterne);
    font-family: var(--mono);
    font-size: 12px;
  }

  .entete__burger {
    display: none;
    width: 44px;
    height: 44px;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .entete__burger span {
    display: block;
    width: 22px;
    height: 2px;
    margin: 5px auto;
    background: var(--papier);
    transition: transform 250ms var(--ease);
  }
  :global(.menu-ouvert) .entete__burger span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  :global(.menu-ouvert) .entete__burger span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  @media (max-width: 1023px) {
    .entete__nav {
      display: none;
    }
    .entete__burger {
      display: block;
    }
    :global(.menu-ouvert) .entete__nav {
      display: flex;
      flex-direction: column;
      gap: 0;
      position: fixed;
      inset: var(--header) 0 0;
      padding: 16px var(--marge) 40px;
      background: var(--encre);
      overflow-y: auto;
    }
    :global(.menu-ouvert) .entete__nav a {
      font-family: var(--titre);
      font-weight: 800;
      font-size: clamp(2rem, 9vw, 3rem);
      color: var(--papier);
      padding: 16px 0;
      border-bottom: 1px solid var(--ligne);
    }
    :global(.menu-ouvert) body {
      overflow: hidden;
    }
  }
  @media (max-width: 719px) {
    .statut {
      display: none;
    }
    .entete__barre {
      gap: 10px;
    }
  }
</style>
