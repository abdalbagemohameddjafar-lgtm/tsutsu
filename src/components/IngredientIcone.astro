---
// Illustrations des ingrédients (section « Ce qu'on roule dedans »), dessinées en SVG.
interface Props {
  id: 'riz' | 'nori' | 'saumon' | 'avocat' | 'sesame' | 'concombre';
}
const { id } = Astro.props;
const grains = Array.from({ length: 22 }, (_, i) => {
  const a = i * 2.39996;
  const d = 8 + ((i * 13) % 26);
  return { x: 60 + Math.cos(a) * d, y: 66 + Math.sin(a) * d * 0.55, r: (i * 47) % 180 };
});
const graines = Array.from({ length: 16 }, (_, i) => {
  const a = i * 2.39996;
  const d = 6 + ((i * 17) % 30);
  return { x: 60 + Math.cos(a) * d, y: 60 + Math.sin(a) * d, r: (i * 61) % 180, noir: i % 4 === 0 };
});
---

<svg viewBox="0 0 120 120" class="ingredient-icone" aria-hidden="true" focusable="false">
  <circle cx="60" cy="60" r="58" fill="#f4f2ee" />
  {id === 'riz' && (
    <g>
      <path d="M22 62 h76 a38 30 0 0 1 -76 0z" fill="#e9e4da" stroke="#151515" stroke-width="3" />
      <ellipse cx="60" cy="62" rx="38" ry="10" fill="#fff" stroke="#151515" stroke-width="3" />
      {grains.map((g) => <ellipse cx={g.x} cy={g.y - 10} rx="4" ry="2" fill="#fff" stroke="#cfc8b8" stroke-width="0.8" transform={`rotate(${g.r} ${g.x} ${g.y - 10})`} />)}
    </g>
  )}
  {id === 'nori' && (
    <g>
      <rect x="28" y="30" width="64" height="60" rx="4" fill="#1b2a20" transform="rotate(-8 60 60)" />
      <g stroke="#2f4636" stroke-width="2" transform="rotate(-8 60 60)">
        <path d="M30 44h60M30 58h60M30 72h60" />
      </g>
    </g>
  )}
  {id === 'saumon' && (
    <g>
      <path d="M20 70 q40 -46 80 -16 q-30 34 -80 16z" fill="#f2845c" stroke="#151515" stroke-width="3" />
      <path d="M38 64 q18 -14 34 -14M48 70 q18 -12 34 -12M60 74 q12 -6 22 -8" stroke="#ffe3d6" stroke-width="3" fill="none" stroke-linecap="round" />
    </g>
  )}
  {id === 'avocat' && (
    <g>
      <path d="M60 18 c22 0 30 30 30 50 a30 32 0 0 1 -60 0 c0 -20 8 -50 30 -50z" fill="#3e6b2b" stroke="#151515" stroke-width="3" />
      <path d="M60 26 c16 0 22 26 22 42 a22 24 0 0 1 -44 0 c0 -16 6 -42 22 -42z" fill="#cfe39a" />
      <circle cx="60" cy="72" r="13" fill="#8a5a33" stroke="#151515" stroke-width="2.5" />
    </g>
  )}
  {id === 'sesame' && (
    <g>
      {graines.map((g) => (
        <ellipse cx={g.x} cy={g.y} rx="6" ry="3.2" fill={g.noir ? '#151515' : '#f7e9c8'} stroke="#151515" stroke-width="1.2" transform={`rotate(${g.r} ${g.x} ${g.y})`} />
      ))}
    </g>
  )}
  {id === 'concombre' && (
    <g>
      <circle cx="60" cy="60" r="36" fill="#3f7d3a" stroke="#151515" stroke-width="3" />
      <circle cx="60" cy="60" r="30" fill="#d6ecb4" />
      <circle cx="60" cy="60" r="14" fill="#b9d98c" />
      {[0, 60, 120, 180, 240, 300].map((a) => (
        <ellipse cx={60 + Math.cos((a * Math.PI) / 180) * 9} cy={60 + Math.sin((a * Math.PI) / 180) * 9} rx="2.4" ry="4" fill="#f4f7e6" transform={`rotate(${a + 90} ${60 + Math.cos((a * Math.PI) / 180) * 9} ${60 + Math.sin((a * Math.PI) / 180) * 9})`} />
      ))}
    </g>
  )}
</svg>

<style>
  .ingredient-icone {
    width: 100%;
    height: auto;
  }
</style>
