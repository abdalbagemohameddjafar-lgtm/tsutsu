---
// Pied de page léger : logo, liens légaux, Instagram, crédit.
// (Horaires, adresse et téléphone sont dans la section « Infos » de l'accueil, une seule fois.)
import Logo from './Logo.astro';
import { restaurant } from '../config/restaurant';
interface Props {
  accueil?: boolean;
}
const { accueil = false } = Astro.props;
const annee = new Date().getFullYear();
---

<footer class="pied">
  <div class="conteneur pied__ligne">
    <a class="pied__logo" href={accueil ? '#top' : '/'}><Logo /><span class="cache"> — accueil</span></a>
    <nav class="pied__nav" aria-label="Liens du pied de page">
      <a href="/carte">Carte et allergènes</a>
      <a href="/mentions-legales">Mentions légales</a>
      <a href="/confidentialite">Confidentialité</a>
      <a href={restaurant.instagram.url} rel="noopener">Instagram</a>
    </nav>
  </div>
  <div class="conteneur pied__legal">
    <p>© {annee} {restaurant.nom} · Restaurant fictif, site de démonstration</p>
    <!-- ごちそうさまでした : ce qu'on dit au Japon à la fin d'un repas -->
    <p class="pied__merci"><span lang="ja">ごちそうさまでした</span> · merci pour ce repas</p>
    <p>Réalisé par <a href={restaurant.realisePar.url} rel="noopener">{restaurant.realisePar.nom}</a></p>
  </div>
  <span class="cache" aria-live="polite" data-annonce-panier></span>
</footer>

<style>
  .pied {
    border-top: 1px solid var(--ligne);
    padding-block: 32px 28px;
    font-size: 15px;
    color: var(--texte-2);
  }
  .pied__ligne {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 32px;
  }
  .pied__logo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 19px;
    color: var(--papier);
    text-decoration: none;
  }
  .pied__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 8px;
    margin-inline: -10px;
  }
  .pied a:not(.pied__logo) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 10px;
    text-underline-offset: 4px;
  }
  .pied__legal a {
    padding-inline: 0 !important;
  }
  .pied a:hover {
    color: var(--lanterne);
  }
  .pied__merci span {
    font-family: var(--titre);
    font-weight: 700;
    color: var(--lanterne);
    letter-spacing: 0.06em;
  }
  .pied__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 24px;
    margin-top: 16px;
    padding-top: 12px;
    border-top: 1px solid var(--ligne);
    font-size: 14px;
  }
</style>
