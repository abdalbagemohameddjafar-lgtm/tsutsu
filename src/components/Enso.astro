---
// Ensō (円相) : cercle tracé d'un seul coup de pinceau, symbole zen. Purement décoratif.
// Le trait est une forme pleine dont l'épaisseur varie le long du cercle (pression du pinceau) :
// attaque large en bas à gauche, trait plein, puis le pinceau se vide et s'effile en « brossé sec »
// avant l'ouverture en haut à droite.
interface Props {
  couleur?: string;
}
const { couleur = 'var(--noir)' } = Astro.props;

const cx = 200, cy = 200, R = 158;
const depart = 125; // degrés (bas gauche) — sens horaire à l'écran
const longueur = 330; // laisse une ouverture d'environ 30°
const N = 160;

// Épaisseur selon l'avancement t (0 → 1) : attaque, plein, puis le pinceau se vide
const epaisseur = (t: number) => {
  const attaque = Math.min(t / 0.06, 1);
  const vide = t > 0.62 ? 1 - (t - 0.62) / 0.38 : 1;
  return 4 + 30 * Math.sin(Math.min(attaque, 1) * Math.PI / 2) * Math.pow(Math.max(vide, 0), 0.8);
};
// Légère irrégularité du rayon (main humaine)
const rayon = (t: number) => R + Math.sin(t * 9.0) * 2.4 + Math.sin(t * 23.0) * 1.1;

const pt = (t: number, decal: number) => {
  const a = ((depart + t * longueur) * Math.PI) / 180;
  const r = rayon(t) + decal;
  return `${(cx + Math.cos(a) * r).toFixed(1)} ${(cy + Math.sin(a) * r).toFixed(1)}`;
};
const ts = Array.from({ length: N + 1 }, (_, i) => i / N);
const contour =
  'M' + ts.map((t) => pt(t, epaisseur(t) / 2)).join(' L') +
  ' L' + [...ts].reverse().map((t) => pt(t, -epaisseur(t) / 2)).join(' L') + ' Z';

// Brossé sec : fines traînées dans la dernière partie du trait
const trainees = [-9, -5, -1, 3, 7].map((d, i) => {
  const t0 = 0.55 + i * 0.03;
  const t1 = 0.86 + (i % 2) * 0.05;
  const seg = ts.filter((t) => t >= t0 && t <= t1);
  return { d: 'M' + seg.map((t) => pt(t, d)).join(' L'), w: 1.6 + (i % 3) * 0.6 };
});
---

<svg class="enso" viewBox="0 0 400 400" aria-hidden="true" focusable="false">
  <path d={contour} fill={couleur} />
  <g fill="none" stroke={couleur} stroke-linecap="round" opacity="0.55">
    {trainees.map((t) => <path d={t.d} stroke-width={t.w} stroke-dasharray="26 5 14 8 30 4" />)}
  </g>
</svg>

<style>
  .enso {
    width: 100%;
    height: auto;
    overflow: visible;
  }
</style>
