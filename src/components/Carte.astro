---
// Section « La carte du comptoir » : filtres en pastilles, grille des 6 temaki, fenêtre détaillée (ingrédients + allergènes).
// Données : src/data/menu.ts · Logique : src/scripts/carte.ts
import Temaki from './Temaki.astro';
import Photo from './Photo.astro';
import { rolls, TAGS, ALLERGENES, sansGluten } from '../data/menu';
import { euros } from '../lib/format';

const filtres = [
  { id: 'tous', texte: 'Tous' },
  { id: 'vege', texte: 'Végé' },
  { id: 'epice', texte: 'Épicé' },
  { id: 'sansgluten', texte: 'Sans gluten' },
];
const prixMin = Math.min(...rolls.map((r) => r.prix));
const prixMax = Math.max(...rolls.map((r) => r.prix));
---

<section class="section carte" id="carte" aria-labelledby="carte-titre">
  <div class="conteneur">
    <div class="carte__tete">
      <h2 id="carte-titre" data-apparition>La carte du comptoir</h2>
      <p class="chapo" data-apparition style="--rang: 1">
        Six temaki, roulés à la commande. De <span class="mono">{euros(prixMin)}</span> à <span class="mono">{euros(prixMax)}</span>.
      </p>
    </div>

    <div class="carte__barre">
      <div class="carte__filtres" role="group" aria-label="Filtrer la carte">
        {filtres.map((f, i) => (
          <button class="pastille" type="button" data-filtre={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>{f.texte}</button>
        ))}
      </div>
      <a class="lien" href="/carte">Carte complète et allergènes</a>
    </div>
    <p class="cache" data-filtre-annonce aria-live="polite"></p>

    <ul class="carte__grille" role="list">
      {rolls.map((r, i) => (
        <li
          class="roll-carte"
          data-tags={[...r.tags, sansGluten(r) ? 'sansgluten' : ''].join(' ')}
          data-apparition
          style={`--rang: ${i % 3}`}
        >
          <button class="roll-carte__ouvrir" type="button" data-ouvrir-roll={r.id} aria-haspopup="dialog">
            <Photo class="roll-carte__visuel" ratio="4 / 3" src={r.photo} webp={r.photoWebp} alt={`${r.nom} : ${r.description}`}>
              <Temaki roll={r} class="roll-carte__temaki" />
            </Photo>
            <span class="roll-carte__nom">{r.nom}</span>
            <span class="ja roll-carte__ja" lang="ja">{r.nomJa}</span>
            <span class="cache">, voir les ingrédients et allergènes</span>
          </button>
          <ul class="roll-carte__tags" role="list" aria-label="Étiquettes">
            {r.tags.map((t) => <li class={`badge badge--${t}`}>{TAGS[t]}</li>)}
            {sansGluten(r) && <li class="badge">Sans gluten</li>}
          </ul>
          <p class="roll-carte__desc">{r.description}</p>
          <div class="roll-carte__pied">
            <span class="roll-carte__prix">{euros(r.prix)}</span>
            <button class="bouton bouton--contour bouton--petit roll-carte__ajouter" type="button" data-ajouter={r.id}>
              <span data-texte-bouton>+ Ajouter</span><span class="cache"> {r.nom} au panier</span>
            </button>
          </div>
        </li>
      ))}
    </ul>
  </div>

  <!-- Fenêtres détaillées (une par temaki) -->
  {rolls.map((r) => (
    <dialog class="modale" id={`roll-${r.id}`} aria-labelledby={`roll-${r.id}-titre`}>
      <div class="modale__corps">
        <button class="modale__fermer" type="button" data-fermer-modale aria-label="Fermer">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
        </button>
        <div class="modale__visuel"><Temaki roll={r} /></div>
        <div class="modale__texte">
          <h3 id={`roll-${r.id}-titre`}>{r.nom}</h3>
          <p class="ja modale__ja" lang="ja">{r.nomJa}</p>
          <p class="modale__prix">{euros(r.prix)}</p>
          <p>{r.description}</p>
          <h4>Ingrédients</h4>
          <p>{r.ingredients.join(', ')}.</p>
          <h4>Allergènes</h4>
          <ul class="modale__allergenes" role="list">
            {r.allergenes.map((a) => <li>{ALLERGENES[a]}</li>)}
          </ul>
          <button class="bouton modale__ajouter" type="button" data-ajouter={r.id}>
            <span data-texte-bouton>+ Ajouter au panier</span>
          </button>
        </div>
      </div>
    </dialog>
  ))}
</section>

<script>
  import '../scripts/carte.ts';
</script>

<style>
  .carte__tete {
    display: grid;
    gap: 16px;
    margin-bottom: 36px;
  }
  .carte__barre {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin-bottom: 28px;
  }
  .carte__filtres {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .carte__grille {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .roll-carte {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 14px 14px 18px;
    background: var(--surface);
    border: 1px solid var(--ligne);
    border-radius: var(--rayon);
    transition:
      transform 300ms var(--ease),
      border-color 300ms var(--ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .roll-carte:hover {
      transform: translateY(-3px);
      border-color: var(--ligne-forte);
    }
    .roll-carte:hover :global(.roll-carte__temaki) {
      transform: rotate(-4deg) scale(1.04);
    }
  }
  .roll-carte__ouvrir {
    display: grid;
    gap: 4px;
    padding: 0;
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
  }
  .roll-carte__ouvrir :global(.roll-carte__visuel) {
    border-radius: 8px;
    margin-bottom: 12px;
  }
  .roll-carte__ouvrir :global(.roll-carte__temaki) {
    width: 46%;
    transition: transform 600ms var(--ease);
  }
  .roll-carte__nom {
    padding-inline: 6px;
    font-family: var(--titre);
    font-weight: 800;
    font-size: clamp(1.3rem, 1.1rem + 0.6vw, 1.6rem);
    line-height: 1.2;
  }
  .roll-carte__ouvrir:hover .roll-carte__nom {
    color: var(--lanterne);
  }
  .roll-carte__ja {
    padding-inline: 6px;
    font-size: 13px;
    color: var(--texte-2);
  }
  /* Ligne d'étiquettes : hauteur réservée même sans badge, pour aligner toutes les cartes */
  .roll-carte__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    min-height: 26px;
    padding-inline: 6px;
  }
  .roll-carte__desc {
    flex: 1;
    padding-inline: 6px;
    color: var(--texte-2);
    font-size: 16px;
    line-height: 1.6;
  }
  .roll-carte__pied {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-inline: 6px;
    padding-top: 14px;
    border-top: 1px dashed var(--ligne-forte);
  }
  .roll-carte__prix {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 1.25rem;
    color: var(--lanterne);
  }
  :global(.ajoute) {
    background: #3f7a52 !important;
    border-color: #3f7a52 !important;
    color: #fff !important;
  }

  /* Fenêtre détaillée */
  .modale {
    width: min(92vw, 820px);
    max-height: 90vh;
    padding: 0;
    border: 1px solid var(--ligne-forte);
    border-radius: var(--rayon);
    background: var(--surface);
    color: var(--papier);
  }
  .modale::backdrop {
    background: rgba(8, 10, 14, 0.72);
  }
  @media (prefers-reduced-motion: no-preference) {
    .modale[open] {
      animation: monte 360ms var(--ease);
    }
  }
  @keyframes monte {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.98);
    }
  }
  .modale__corps {
    position: relative;
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 32px;
    padding: 36px;
    align-items: center;
  }
  .modale__visuel {
    padding: 24px;
    border-radius: 10px;
    background: radial-gradient(60% 55% at 50% 45%, rgba(240, 162, 59, 0.18), transparent 70%), var(--surface-2);
  }
  .modale__fermer {
    position: absolute;
    top: 10px;
    right: 10px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }
  .modale__fermer:hover {
    background: var(--surface-2);
  }
  .modale__texte {
    display: grid;
    gap: 10px;
  }
  .modale__texte h3 {
    font-size: clamp(1.7rem, 1.3rem + 1.4vw, 2.4rem);
    font-weight: 800;
  }
  .modale__texte h4 {
    margin: 10px 0 0;
    font-family: var(--mono);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lanterne);
  }
  .modale__ja {
    margin-top: -6px;
    font-size: 15px;
    color: var(--texte-2);
  }
  .modale__prix {
    font-family: var(--mono);
    font-size: 1.4rem;
    color: var(--lanterne);
  }
  .modale__allergenes {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .modale__allergenes li {
    padding: 4px 12px;
    border-radius: 999px;
    border: 1px solid var(--ligne-forte);
    font-size: 14px;
    font-weight: 700;
  }
  .modale__ajouter {
    justify-self: start;
    margin-top: 10px;
  }

  @media (max-width: 1023px) {
    .carte__grille {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 639px) {
    .carte__grille {
      grid-template-columns: 1fr;
    }
    .roll-carte__ouvrir :global(.roll-carte__visuel) {
      aspect-ratio: 16 / 10 !important;
    }
    .roll-carte__ouvrir :global(.roll-carte__temaki) {
      width: 34%;
    }
    .modale__corps {
      grid-template-columns: 1fr;
      padding: 56px 22px 24px;
      gap: 20px;
    }
    .modale__visuel {
      width: 60%;
      margin-inline: auto;
      padding: 16px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .roll-carte,
    .roll-carte__ouvrir :global(.roll-carte__temaki) {
      transition: none;
    }
  }
</style>
