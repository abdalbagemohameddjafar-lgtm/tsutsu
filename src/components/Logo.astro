---
// Logo texte : « TSUTSU » en Mincho + kanji 筒 (tsutsu) couleur lanterne.
interface Props {
  class?: string;
}
const { class: classe } = Astro.props;
---

<span class:list={['logo', classe]}>
  TSUTSU<span class="logo__kanji" lang="ja">筒</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.28em;
    font-family: var(--titre);
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1;
  }
  .logo__kanji {
    display: inline-grid;
    place-items: center;
    width: 1.35em;
    height: 1.35em;
    border-radius: 50%;
    background: var(--lanterne);
    color: var(--encre);
    font-weight: 700;
    font-size: 0.8em;
    letter-spacing: 0;
  }
</style>
