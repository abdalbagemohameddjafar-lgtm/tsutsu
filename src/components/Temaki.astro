---
// Illustration originale d'un temaki : cône de nori, bourrelet de riz, garniture qui dépasse.
// Les couleurs viennent de src/data/menu.ts (visuel.garniture et visuel.topping).
import type { Roll } from '../data/menu';
interface Props {
  roll: Roll;
  class?: string;
}
const { roll, class: classe } = Astro.props;
const { garniture, topping } = roll.visuel;
const u = `tmk-${roll.id}`;

// Garniture : des bâtonnets arrondis qui sortent du cône en éventail (une couleur par ingrédient)
const positions = [
  { x: 108, y: 40, a: 8, l: 88, w: 38 },
  { x: 70, y: 52, a: -26, l: 76, w: 32 },
  { x: 148, y: 38, a: 32, l: 74, w: 30 },
];
const batons = garniture.slice(0, 3).map((couleur, i) => ({ ...positions[i], couleur })).reverse();

// Petits éléments posés sur le dessus (répartition régulière, calculée une fois)
const points: { x: number; y: number; r: number }[] = [];
for (let i = 0; i < 22; i++) {
  const t = (i * 0.618) % 1;
  points.push({ x: 56 + t * 104, y: 40 + ((i * 37) % 30) - t * 10, r: 2.6 + ((i * 7) % 3) * 0.5 });
}
---

<svg class:list={['temaki', classe]} viewBox="0 0 220 240" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`${u}-nori`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#2c3a2f" />
      <stop offset="1" stop-color="#121a15" />
    </linearGradient>
    <linearGradient id={`${u}-pli`} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#3a4b3d" />
      <stop offset="1" stop-color="#202b23" />
    </linearGradient>
  </defs>

  <!-- ombre portée -->
  <ellipse cx="104" cy="226" rx="46" ry="6" fill="#000" opacity="0.35" />

  <!-- bord arrière du cône -->
  <path d="M34 92 C 60 48, 152 30, 186 64 C 150 52, 80 66, 34 92 Z" fill="#0d130f" />

  <!-- garniture -->
  {batons.map((b) => (
    <rect
      x={b.x - b.w / 2}
      y={b.y - b.l / 2}
      width={b.w}
      height={b.l}
      rx={b.w / 2.2}
      fill={b.couleur}
      transform={`rotate(${b.a} ${b.x} ${b.y})`}
    />
  ))}
  <!-- reflet sur le premier ingrédient -->
  <path d="M96 22 q6 -6 14 -2" stroke="#fff" stroke-width="3" stroke-linecap="round" fill="none" opacity="0.4" />

  <!-- cône de nori -->
  <path d="M30 94 C 74 72, 146 56, 190 64 L 98 222 Z" fill={`url(#${u}-nori)`} />
  <!-- pli de la feuille -->
  <path d="M30 94 C 70 84, 112 74, 132 70 L 98 222 Z" fill={`url(#${u}-pli)`} />
  <!-- texture de l'algue -->
  <g stroke="#4a5c4c" stroke-width="1" opacity="0.5" fill="none">
    <path d="M60 110 L 92 196" />
    <path d="M118 94 L 104 180" />
    <path d="M150 82 L 112 168" />
  </g>

  <!-- riz -->
  <path
    d="M26 96 C 30 82, 44 80, 52 82 C 58 72, 74 72, 82 76 C 92 66, 108 66, 116 70 C 126 60, 144 60, 152 64 C 162 56, 180 58, 186 64 C 194 66, 196 74, 190 76 C 148 70, 76 82, 26 100 Z"
    fill="#f4efe4"
  />
  <g fill="#fffaf0" stroke="#d9d0bd" stroke-width="0.7">
    <ellipse cx="48" cy="88" rx="5" ry="2.6" transform="rotate(-20 48 88)" />
    <ellipse cx="76" cy="80" rx="5" ry="2.6" transform="rotate(10 76 80)" />
    <ellipse cx="104" cy="74" rx="5" ry="2.6" transform="rotate(-8 104 74)" />
    <ellipse cx="132" cy="68" rx="5" ry="2.6" transform="rotate(20 132 68)" />
    <ellipse cx="164" cy="66" rx="5" ry="2.6" transform="rotate(-14 164 66)" />
  </g>

  <!-- dessus -->
  {topping === 'tobiko' && points.map((p) => <circle cx={p.x} cy={p.y} r={p.r} fill="#e8572f" />)}
  {topping === 'sesame' && points.map((p, i) => (
    <ellipse cx={p.x} cy={p.y} rx="3.2" ry="1.6" fill={i % 3 ? '#fffaf0' : '#1a1a1a'} transform={`rotate(${i * 41} ${p.x} ${p.y})`} />
  ))}
  {topping === 'oignon' && points.filter((_, i) => i % 2 === 0).map((p, i) => (
    <path d={`M${p.x - 6} ${p.y} q6 -6 12 0`} stroke="#d39a4a" stroke-width="3.2" stroke-linecap="round" fill="none" transform={`rotate(${i * 37} ${p.x} ${p.y})`} />
  ))}
  {topping === 'piment' && points.filter((_, i) => i % 2 === 0).map((p) => (
    <circle cx={p.x} cy={p.y} r="3.4" fill="#d9482b" stroke="#ffd9a8" stroke-width="1.1" />
  ))}
</svg>

<style>
  .temaki {
    width: 100%;
    height: auto;
    overflow: visible;
  }
</style>
