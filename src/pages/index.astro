---
// Page d'accueil TSUTSU — comptoir à temaki, ambiance izakaya du soir.
import Base from '../layouts/Base.astro';
import Carte from '../components/Carte.astro';
import Reservation from '../components/Reservation.astro';
import Infos from '../components/Infos.astro';
import Photo from '../components/Photo.astro';
import Lanterne from '../components/Lanterne.astro';
import Temaki from '../components/Temaki.astro';
import { restaurant, offreEtudiante } from '../config/restaurant';
import { rolls, ingredientsVedettes } from '../data/menu';
import { euros } from '../lib/format';

// Bandeau défilant (français uniquement)
const motsBande = ['Roulé à la main', '100 % halal', 'Nori grillée', 'Riz encore tiède', 'Sur place ou à emporter', `${restaurant.adresse.ville}`];
const [classique, spicy, mango] = [rolls[0], rolls[1], rolls[2]];
---

<Base accueil>
  <!-- Hero : comptoir la nuit, sous le noren et les lanternes -->
  <section class="hero" id="top" aria-labelledby="hero-titre">
    <div class="hero__fond">
      <!-- Photo du hero : passez src="/photos/hero.jpg" (et webp) pour remplacer l'illustration -->
      <Photo class="hero__photo" alt="Le comptoir de TSUTSU le soir, sous le rideau d’entrée et les lanternes allumées" prioritaire>
        <div class="scene" aria-hidden="true">
          <!-- Noren (rideau d'entrée) : 手巻き寿司 = temaki-zushi, « sushi roulé à la main » -->
          <!-- Tringle en bois : le noren et les lanternes y sont accrochés -->
          <div class="scene__tringle"></div>
          <div class="scene__noren">
            {['手', '巻', 'き', '寿', '司'].map((c, i) => <span style={`--pan: ${i}`}><b lang="ja">{c}</b></span>)}
          </div>
          <div class="scene__comptoir">
            <div class="scene__temaki scene__temaki--1"><Temaki roll={classique} /></div>
            <div class="scene__temaki scene__temaki--2"><Temaki roll={spicy} /></div>
            <div class="scene__temaki scene__temaki--3"><Temaki roll={mango} /></div>
          </div>
        </div>
      </Photo>
      <!-- Lanternes cliquables (au-dessus de l'illustration). À retirer si une vraie photo remplace la scène. -->
      <div class="hero__lanternes">
        <div class="scene__lanterne scene__lanterne--g"><span class="scene__corde"></span><Lanterne id="lanterne-g" kanji="寿司" delai={0.4} interactif /></div>
        <div class="scene__lanterne scene__lanterne--d"><span class="scene__corde"></span><Lanterne id="lanterne-d" kanji="手巻" delai={0.9} interactif /></div>
      </div>
    </div>

    <div class="conteneur hero__contenu">
      <p class="surtitre">Comptoir à temaki · {restaurant.adresse.ville}</p>
      <h1 id="hero-titre">Roulé à la main. <span class="accent">Mangé dans la minute.</span></h1>
      <p class="chapo hero__texte">
        Une feuille de nori grillée, du riz encore tiède, une garniture généreuse : chaque temaki est roulé devant vous
        et se mange tout de suite, tant que l’algue croque.
      </p>
      <div class="hero__actions">
        <a class="bouton" href="#carte">Voir la carte</a>
        <a class="bouton bouton--contour" href="#reserver">Réserver au comptoir</a>
      </div>
    </div>
  </section>

  <!-- Bandeau défilant -->
  <div class="bande" role="img" aria-label={motsBande.join(', ')}>
    <div class="bande__piste">
      {[0, 1].map(() => (
        <p class="bande__texte" aria-hidden="true">
          {motsBande.map((m) => <><span>{m}</span><span class="bande__sep">•</span></>)}
        </p>
      ))}
    </div>
  </div>

  <!-- La carte -->
  <Carte />

  <!-- Le comptoir -->
  <section class="section comptoir" id="comptoir" aria-labelledby="comptoir-titre">
    <div class="conteneur comptoir__grille" data-centre data-aimant>
      <!-- Photo du comptoir : passez src="/photos/comptoir.jpg" (et webp) pour remplacer l'illustration -->
      <div class="comptoir__media">
      <Photo class="comptoir__photo" ratio="4 / 3" alt="Deux temaki posés sur un support en bois, sous la lanterne du comptoir">
        <div class="comptoir__scene" aria-hidden="true">
          <div class="comptoir__planche"></div>
          <!-- support en bois où l'on pose les temaki, pointe en bas -->
          <div class="comptoir__temaki comptoir__temaki--1"><Temaki roll={rolls[3]} /></div>
          <div class="comptoir__temaki comptoir__temaki--2"><Temaki roll={rolls[4]} /></div>
          <div class="comptoir__support"></div>
        </div>
      </Photo>
        <div class="comptoir__lanterne"><Lanterne id="lanterne-comptoir" kanji="筒" delai={0.2} interactif /></div>
      </div>
      <div class="comptoir__texte">
        <p class="kotoba" data-apparition><span class="kotoba__ja" lang="ja">カウンター</span><span class="kotoba__fr">kauntā · le comptoir</span></p>
        <h2 id="comptoir-titre" data-apparition>Pourquoi au comptoir ?</h2>
        <p class="chapo" data-apparition style="--rang: 1">
          Un temaki n’attend pas : au bout de quelques minutes, la nori ramollit. Alors on le roule au moment où vous
          commandez, et on vous le tend par-dessus le comptoir.
        </p>
        <p class="comptoir__infos mono" data-apparition style="--rang: 2">Halal · Ouvert 7j/7 · 11h–22h</p>
      </div>
    </div>
  </section>

  <!-- Ingrédients -->
  <section class="section ingredients" id="ingredients" aria-labelledby="ingredients-titre">
    <div class="conteneur" data-centre data-aimant>
      <p class="kotoba" data-apparition><span class="kotoba__ja" lang="ja">材料</span><span class="kotoba__fr">zairyō · les ingrédients</span></p>
      <h2 id="ingredients-titre" data-apparition>Ce qu’il y a dans le cône</h2>
      <ol class="ingredients__liste" role="list">
        {ingredientsVedettes.map((ing, i) => (
          <li data-apparition style={`--rang: ${i % 2}`}>
            <span class="ingredients__num mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{ing.nom}</h3>
            <p>{ing.texte}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Offre étudiante : ticket de comptoir -->
  <section class="offre" aria-labelledby="offre-titre">
    <div class="conteneur">
      <div class="ticket" data-apparition data-centre data-aimant>
        <div class="ticket__haut">
          <p class="ticket__label mono">Ticket étudiant</p>
          <!-- 学割 (gakuwari) : « réduction étudiante » -->
          <p class="ticket__ja" lang="ja" aria-hidden="true">学割</p>
        </div>
        <h2 id="offre-titre" class="ticket__prix mono">{euros(offreEtudiante.prix)}</h2>
        <p class="ticket__texte">{offreEtudiante.contenu}.</p>
        <div class="ticket__bas">
          <p class="mono ticket__mention">Valable tous les jours · sur place ou à emporter</p>
          <button class="bouton" type="button" data-ouvrir-panier aria-haspopup="dialog">Commander <span class="fleche" aria-hidden="true">→</span></button>
        </div>
      </div>
    </div>
  </section>

  <!-- Réserver -->
  <Reservation />

  <!-- Infos -->
  <Infos />
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding-top: calc(var(--header) + var(--tringle) + var(--noren) + 20px);
    padding-bottom: calc(var(--comptoir) + 24px);
    overflow: hidden;
    --noren: clamp(44px, 9vh, 104px);
    --comptoir: clamp(52px, 13vh, 150px);
    --lanterne-l: clamp(46px, min(7vw, 13vh), 116px);
    --tringle: 8px;
  }
  .hero__fond {
    position: absolute;
    inset: 0;
  }
  .hero__fond :global(.hero__photo) {
    height: 100%;
  }
  .hero__fond::after {
    /* voile sombre : garde le texte lisible, avec ou sans vraie photo */
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(70% 60% at 50% 50%, rgba(18, 22, 31, 0.55), transparent 80%);
    pointer-events: none;
  }
  .scene {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(40% 50% at 12% 30%, rgba(240, 162, 59, 0.16), transparent 70%),
      radial-gradient(40% 50% at 88% 30%, rgba(240, 162, 59, 0.16), transparent 70%),
      var(--encre);
  }
  /* Noren : rideau d'entrée en cinq pans, sous l'en-tête */
  .scene__tringle {
    position: absolute;
    top: var(--header);
    left: 0;
    right: 0;
    height: var(--tringle);
    z-index: 1;
    background: linear-gradient(to bottom, #6b4a30, #3a2716);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.45);
  }
  .scene__noren {
    position: absolute;
    top: calc(var(--header) + var(--tringle) - 1px);
    left: 0;
    right: 0;
    height: var(--noren);
    display: flex;
    gap: 4px;
  }
  .scene__noren span {
    flex: 1;
    display: grid;
    place-items: center;
    background:
      linear-gradient(to bottom, rgba(0, 0, 0, 0.25), transparent 30%),
      var(--surface-2);
    border-radius: 0 0 4px 4px;
  }
  /* Le rideau vacille : grand mouvement à l'arrivée, puis une brise légère et continue */
  .scene__noren span {
    transform-origin: 50% 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .scene__noren span {
      animation:
        noren-entree 2.4s calc(var(--pan) * 110ms) cubic-bezier(0.3, 0.6, 0.3, 1) both,
        noren-vent 4.2s calc(2.4s + var(--pan) * 0.35s) ease-in-out infinite alternate;
    }
  }
  @keyframes noren-entree {
    0% {
      transform: skewX(10deg) scaleY(0.96);
    }
    22% {
      transform: skewX(-7deg);
    }
    44% {
      transform: skewX(4deg);
    }
    66% {
      transform: skewX(-2deg);
    }
    100% {
      transform: skewX(0);
    }
  }
  @keyframes noren-vent {
    from {
      transform: skewX(0);
    }
    to {
      transform: skewX(2.2deg);
    }
  }
  .scene__noren b {
    font-family: var(--titre);
    font-weight: 700;
    font-size: clamp(20px, calc(var(--noren) * 0.5), 52px);
    color: var(--papier);
    opacity: 0.9;
  }
  .hero__lanternes {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }
  .hero__lanternes :global(.lanterne) {
    pointer-events: auto;
  }
  @media (max-width: 719px) {
    /* lanternes trop petites sur téléphone : on retire les kanji, qui seraient illisibles */
    .hero__lanternes :global(.lanterne__kanji) {
      display: none;
    }
  }
  /* Chaque lanterne pend à la tringle par une cordelette, sous le rideau, près des bords */
  .scene__lanterne {
    position: absolute;
    top: var(--header);
    width: var(--lanterne-l);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .scene__corde {
    position: relative;
    width: 2px;
    height: calc(var(--tringle) + var(--noren) + 4px);
    margin-bottom: -2px;
    background: #8a7a66;
  }
  .scene__corde::before {
    /* crochet sur la tringle */
    content: '';
    position: absolute;
    top: 1px;
    left: 50%;
    width: 8px;
    height: 8px;
    translate: -50% 0;
    border-radius: 50%;
    background: #2a1d12;
    box-shadow: 0 0 0 1.5px #8a7a66;
  }
  .scene__lanterne--g {
    left: clamp(6px, 1.6vw, 36px);
  }
  .scene__lanterne--d {
    right: clamp(6px, 1.6vw, 36px);
  }
  /* Comptoir en bois, avec trois temaki posés */
  .scene__comptoir {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--comptoir);
    background:
      linear-gradient(to bottom, rgba(240, 162, 59, 0.55), rgba(240, 162, 59, 0) 3px),
      repeating-linear-gradient(0deg, transparent 0 11px, rgba(0, 0, 0, 0.12) 11px 12px),
      linear-gradient(to bottom, #3a2a1c, #241a12);
  }
  .scene__temaki {
    position: absolute;
    bottom: calc(100% - 6px);
    width: clamp(44px, min(6vw, 11vh), 150px);
  }
  .scene__temaki--1 {
    left: 10%;
    rotate: -10deg;
  }
  .scene__temaki--2 {
    left: 20%;
    rotate: 6deg;
    width: clamp(36px, min(4.6vw, 8.5vh), 116px);
  }
  .scene__temaki--3 {
    right: 12%;
    rotate: -4deg;
  }

  .hero__contenu {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: clamp(14px, 2.6vh, 26px);
    text-align: center;
  }
  .hero h1 {
    /* Taille limitée par la largeur ET la hauteur : tout tient dans le premier écran */
    font-size: clamp(2.3rem, min(7.2vw, 8.6vh), 6.6rem);
    line-height: 1.08;
    max-width: 16ch;
  }
  .hero h1 .accent {
    display: block;
  }
  .hero__texte {
    max-width: 50ch;
    color: var(--papier);
    opacity: 0.86;
    font-size: clamp(1rem, 0.9rem + 0.35vw, 1.2rem);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 6px;
  }
  @media (max-width: 719px) {
    .hero {
      --noren: 40px;
      --comptoir: 44px;
    }
    .hero {
      --lanterne-l: 40px;
      /* la lanterne pend sous le rideau : le texte commence en dessous */
      padding-top: calc(var(--header) + var(--tringle) + var(--noren) + 96px);
    }
    .scene__temaki--2 {
      display: none;
    }
    .hero__actions {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }
  }
  @media (max-width: 719px) and (max-height: 760px) {
    .scene__temaki {
      display: none;
    }
  }
  @media (max-height: 560px) {
    .scene__temaki {
      display: none;
    }
  }

  /* ---------- Bandeau défilant ---------- */
  .bande {
    overflow: hidden;
    padding: 16px 0;
    border-block: 1px solid var(--ligne);
    background: var(--surface);
  }
  .bande__piste {
    display: flex;
    width: max-content;
    animation: defile 44s linear infinite;
  }
  .bande:hover .bande__piste {
    animation-play-state: paused;
  }
  .bande__texte {
    display: flex;
    gap: 28px;
    padding-right: 28px;
    font-family: var(--titre);
    font-weight: 700;
    font-size: clamp(1.1rem, 0.9rem + 0.8vw, 1.6rem);
    white-space: nowrap;
  }
  .bande__sep {
    color: var(--lanterne);
  }
  @keyframes defile {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bande__piste {
      animation: none;
    }
  }

  /* ---------- Le comptoir ---------- */
  .comptoir__grille {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }
  .comptoir__grille :global(.comptoir__photo) {
    border-radius: var(--rayon);
    border: 1px solid var(--ligne);
  }
  .comptoir__scene {
    position: absolute;
    inset: 0;
  }
  .comptoir__media {
    position: relative;
  }
  .comptoir__lanterne {
    position: absolute;
    top: 0;
    left: 14%;
    width: 18%;
  }
  .comptoir__planche {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 26%;
    background:
      linear-gradient(to bottom, rgba(240, 162, 59, 0.5), rgba(240, 162, 59, 0) 3px),
      repeating-linear-gradient(0deg, transparent 0 9px, rgba(0, 0, 0, 0.12) 9px 10px),
      linear-gradient(to bottom, #3a2a1c, #241a12);
  }
  .comptoir__temaki {
    position: absolute;
    bottom: 27%;
    width: 22%;
  }
  .comptoir__temaki--1 {
    left: 46%;
    rotate: -8deg;
  }
  .comptoir__temaki--2 {
    left: 66%;
    rotate: 7deg;
  }
  .comptoir__support {
    position: absolute;
    left: 42%;
    width: 50%;
    bottom: 24%;
    height: 12%;
    border-radius: 6px 6px 2px 2px;
    background:
      linear-gradient(to bottom, rgba(240, 162, 59, 0.45), rgba(240, 162, 59, 0) 2px),
      linear-gradient(to bottom, #5a4130, #3a2a1c);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.35);
  }
  .comptoir__texte {
    display: grid;
    gap: 20px;
  }
  .comptoir__infos {
    font-size: 14px;
    letter-spacing: 0.08em;
    color: var(--lanterne);
  }
  @media (max-width: 899px) {
    .comptoir__grille {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Ingrédients : liste éditoriale sur deux colonnes ---------- */
  .ingredients {
    padding-top: 0;
  }
  .ingredients__liste {
    margin-top: clamp(32px, 5vw, 64px);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(32px, 6vw, 96px);
    border-top: 1px solid var(--ligne);
  }
  .ingredients__liste li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 4px 16px;
    padding-block: 22px;
    border-bottom: 1px solid var(--ligne);
  }
  .ingredients__num {
    grid-row: span 2;
    padding-top: 4px;
    font-size: 14px;
    color: var(--lanterne);
  }
  .ingredients__liste p {
    color: var(--texte-2);
  }
  @media (max-width: 767px) {
    .ingredients__liste {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Offre étudiante : ticket de comptoir ---------- */
  .offre {
    padding-bottom: clamp(48px, 6.7vw, 90px);
  }
  .ticket {
    position: relative;
    max-width: 640px;
    margin-inline: auto;
    display: grid;
    gap: 14px;
    padding: clamp(24px, 4vw, 40px);
    background: var(--papier);
    color: var(--encre);
    border-radius: 6px;
    rotate: -1.2deg;
    /* encoches de ticket sur les côtés */
    -webkit-mask: radial-gradient(14px at 0 62%, #0000 98%, #000) left / 51% 100% no-repeat,
      radial-gradient(14px at 100% 62%, #0000 98%, #000) right / 51% 100% no-repeat;
    mask: radial-gradient(14px at 0 62%, #0000 98%, #000) left / 51% 100% no-repeat,
      radial-gradient(14px at 100% 62%, #0000 98%, #000) right / 51% 100% no-repeat;
  }
  .ticket__haut {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-bottom: 12px;
    border-bottom: 1.5px dashed rgba(18, 22, 31, 0.3);
  }
  .ticket__label {
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .ticket__ja {
    font-family: var(--titre);
    font-weight: 700;
    font-size: 18px;
    color: #b13a20;
    letter-spacing: 0.1em;
  }
  .ticket__prix {
    font-family: var(--mono);
    font-weight: 500;
    font-size: clamp(3.4rem, 2rem + 6vw, 6rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .ticket__texte {
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem);
    font-weight: 500;
  }
  .ticket__bas {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-top: 10px;
    padding-top: 18px;
    border-top: 1.5px dashed rgba(18, 22, 31, 0.3);
  }
  .ticket__mention {
    font-size: 13px;
    color: #4a4740;
  }
  .ticket .bouton {
    background: var(--encre);
    border-color: var(--encre);
    color: var(--papier);
  }
  .ticket .bouton:hover {
    background: var(--surface-2);
  }
</style>
